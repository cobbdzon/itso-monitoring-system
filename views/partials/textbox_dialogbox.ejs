<div class="dialogbox">
    <div class="title">
        <%= dialogTitle %> 
    </div>
    <div class="description">
        <%= dialogDescription %> 
    </div>
    <div class="textbox">
        <input type="text">
    </div>
    <div class="buttons">
        <button class="no">
            <%= dialogNo %> 
        </button>
        <button class="yes">
            <%= dialogYes %> 
        </button>
    </div>
</div>