<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <%- include('partials/nav', {navLocation: navLocation}); %>
    <main>
        <div id="form-container">
            <form id="login-form" action="/api/register" method="post">
                <header>
                    CREATE A NEW CLA ACCOUNT
                </header>
                <div id="flash">
                    <%- include('partials/flash', {messages: messages}); %>
                </div>
                <div class="field">
                    <label for="username">CLA FULL NAME:</label>
                    <input id="username" name="username" type="text" autocomplete="off">
                </div>
                <div class="field">
                    <label for="password">PASSWORD:</label>
                    <input id="password" name="password" type="password" autocomplete="off">
                </div>
                <div class="field">
                    <label for="confirm-Password">CONFIRM PASSWORD:</label>
                    <input id="confirm-Password" name="confirmPassword" type="password" autocomplete="off">
                </div>
                <div class="submit">
                    <input id="submit" type="submit" value="REGISTER">
                </div>
                <div class="text">
                    Already have an account? <a href="/login">Log in</a>
                </div>
            </form>
        </div>
    </main>
</body>

</html>