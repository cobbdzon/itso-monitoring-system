doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Log in
    link(rel="stylesheet", href="/css/login.css")
  body
    .main-container
      #form-container
        header
          span.title Log in
          span.description Welcome back
        form(action="#")
          .field
            input#user(list="users" placeholder="User")
            datalist#users
              each user in users
                option(value=user)
          .field
            input#password(type="password" placeholder="Password")
          .button 
            input#submit(type="submit" value="Log in")
