<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in</title>
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <%- include('partials/nav', {navLocation: navLocation}); %>
        <main>
            <div id="form-container">
                <form id="login-form" action="/api/login" method="post">
                    <header>
                        COMPUTER LAB ASSISTANT <br>
                        MONITORING SYSTEM
                    </header>
                    <div id="flash">
                        <%- include('partials/flash', {messages: messages}); %>
                    </div>
                    <div class="field">
                        <label for="username">USERNAME:</label>
                        <input id="username" name="username" list="users" type="text" autocomplete="off">
                        <datalist id="users">
                            <% users.forEach(function(username){ %>
                                <option>
                                    <%= username %>
                                </option>
                            <% }); %>
                        </datalist>
                    </div>
                    <div class="field">
                        <label for="password">PASSWORD:</label>
                        <input id="password" name="password" type="password" autocomplete="off">
                    </div>
                    <div class="submit">
                        <input id="submit" type="submit" value="LOG IN">
                    </div>
                    <div class="text">
                        Are you a new CLA? <a href="/register">Register</a>
                    </div>
                </form>
            </div>
        </main>
</body>

</html>