<!DOCTYPE html>
<html>

<head>
    <title>
        CLA
    </title>
    <link rel='stylesheet' href='/css/index.css' />
</head>

<body>
    <%- include('partials/nav', {navLocation: navLocation}); %>
    <main>
        <header>
            Welcome, <%= username %>
        </header>
        <div id="info">
            <span>
                <b>You are currently:</b>
                <%= userStatus %>
            </span>
            <span>
                <b>Last Log time:</b>
                <%= lastLog %>
            </span>
        </div>

        <div id="buttons">
            <form action="/api/logout" method="post">
                <input type="submit" value="Logout"></inpit>
            </form>

            <% if (isTimedIn==false) { %>
                <form action="/api/timein" method="post">
                    <input type="submit" value="Time in"></inpit>
                </form>
            <% } %>

            <% if (isTimedIn==true) { %>
                <form action="/api/timeout" method="post">
                    <input type="submit" value="Time out"></inpit>
                </form>
            <% } %>
        </div>
    </main>
</body>

</html>